# Copie este ficheiro para ".env" e preencha com os seus valores reais.
# NUNCA cometa o ficheiro ".env" para um repositório público.

PORT=4000
NODE_ENV=production

# Ligação ao PostgreSQL
DATABASE_URL=postgresql://contafacil_user:escolha_uma_senha_forte@localhost:5432/contafacil

# Segredo usado para assinar os tokens JWT (gere um valor aleatório longo)
# Sugestão para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_isto_por_uma_string_aleatoria_longa

# Duração do token de sessão
JWT_EXPIRES_IN=7d

# Domínio(s) autorizados a chamar a API (o seu frontend), separados por vírgula.
# Para testar no seu computador, sirva o ficheiro contafacil-mz.html com um
# servidor local (ver README, secção "Testar em localhost") e coloque aqui
# exatamente esse endereço, por exemplo:
CORS_ORIGIN=http://localhost:8080

# ===================== M-PESA (Vodacom Moçambique) =====================
# Deixe tudo em baixo vazio para o sistema funcionar em MODO DE SIMULAÇÃO
# (pagamentos M-Pesa são sempre aceites automaticamente, sem contactar a
# Vodacom — ótimo para testar o sistema). Para ligar à Vodacom a sério,
# registe-se no portal de desenvolvedores M-Pesa e preencha estes valores:
MPESA_API_HOST=api.sandbox.vm.co.mz
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ORIGIN=*

# ===================== E-MOLA (Movitel) =====================
# A Movitel não publica documentação pública da API do e-Mola — contacte-os
# diretamente para obter o endpoint e as credenciais. Até lá, deixe vazio
# para o sistema funcionar em MODO DE SIMULAÇÃO.
EMOLA_API_URL=
EMOLA_API_KEY=
EMOLA_MERCHANT_ID=
